# Copy to .env (git-ignored) and replace every REPLACE_ME. See
# specs/001-platform-foundation/contracts/settings.md for every setting.
# Values here are the host-side ones; deploy/compose.yaml overrides DB host/port and the
# account file path inside containers ("Host and container values").

ADLC_ENV=dev

# Data store
ADLC_DB_HOST=localhost
ADLC_DB_PORT=5432
ADLC_DB_NAME=adlc
ADLC_DB_APP_USER=adlc_app
ADLC_DB_APP_PASSWORD=REPLACE_ME
ADLC_DB_OWNER_USER=adlc_owner
ADLC_DB_OWNER_PASSWORD=REPLACE_ME
ADLC_DB_CONNECT_TIMEOUT=60s
# Container superuser: used only by the init script, never by a platform service.
POSTGRES_PASSWORD=REPLACE_ME

# Sessions and accounts
ADLC_SESSION_SECRET=REPLACE_ME
ADLC_SESSION_TTL=8h
# Absolute path to the account file outside the repo, e.g. $HOME/.config/adlc/accounts.dev.yaml
ADLC_ACCOUNTS_FILE=/ABSOLUTE/PATH/TO/accounts.dev.yaml
ADLC_ROLE_CATALOGUE=adlc-specs/shared/roles.yaml

# Tracing and logging
ADLC_OTLP_ENDPOINT=http://jaeger:4318
ADLC_LOG_LEVEL=INFO

# Orchestrator (feature 003). ADLC_TIME_SCALE multiplies every timer and retry delay;
# 0.0001 turns a 7-day timer into about a minute for demos.
ADLC_TIME_SCALE=1.0
ADLC_POLL_INTERVAL=1s
ADLC_LEASE=5min
ADLC_HEARTBEAT_MAX_AGE=30s
# How often declared monitors (T8 spec) are evaluated, in real time (feature 012)
ADLC_MONITOR_INTERVAL=1min
# Role allowed to list and re-queue dead-lettered events (must exist in the role catalogue)
ADLC_DEADLETTER_ROLE=adlc_coe
# Synthetic evidence and artifacts until features 006 and 009-012 exist (feature 004).
# Every decision that reads them is labelled synthetic. `off` disables them.
ADLC_SYNTHETIC_DIR=data/synthetic

# Evidence ledger (feature 005). Files attached to artifacts; back this folder up with the
# database. Size limit in bytes (kB/MB = 10^3/10^6). Types: comma-separated media types.
ADLC_FILE_STORE_DIR=data/files
ADLC_ATTACHMENT_MAX=25MB
ADLC_ATTACHMENT_TYPES=application/vnd.openxmlformats-officedocument.wordprocessingml.document,application/vnd.openxmlformats-officedocument.spreadsheetml.sheet,application/pdf,image/png,image/svg+xml,text/plain,text/markdown

# Host ports published by deploy/compose.yaml
ADLC_API_PORT=8000
ADLC_JAEGER_UI_PORT=16686

# Agent runtime (feature 006). Provider keys are secrets: set them only in your local .env.
# dev profile: GPT-4o mini first for every tier (agents and reviewer); default profile: Claude first.
# Spec folder read at run time for prompts, playbooks and checklists (hashes are checked).
ADLC_SPEC_DIR=adlc-specs
ADLC_MODEL_PROFILE=dev
# stub: no model calls (tests, no keys). model: the real reviewer through the gateway.
ADLC_REVIEWER_MODE=stub
# Leave empty for no key (that provider is skipped). Never commit a real key.
ADLC_OPENAI_API_KEY=
ADLC_ANTHROPIC_API_KEY=
ADLC_GEMINI_API_KEY=
ADLC_AGENT_CORRECTIONS=2
ADLC_MODEL_OUTAGE_LIMIT=30min
ADLC_COST_ALERT_LEVELS=5,20,50
# Per tier limits (JSON); empty keeps the defaults. Each timeout plus 30 s must be shorter than
# ADLC_LEASE. Example: {"reasoning": {"steps": 8, "tokens": 400000, "timeout_s": 240}}
ADLC_AGENT_LIMITS=
# Per terminal overrides (JSON), e.g. {"<terminal id>": {"timeout_s": 200}}
ADLC_AGENT_LIMIT_OVERRIDES=

# Knowledge MCP server (feature 008): the T0-T2 agents' grounding over a local document folder.
# The token is a shared secret between the orchestrator and the knowledge server (at least 16
# characters). Never commit a real value.
ADLC_KNOWLEDGE_URL=http://knowledge:8020
ADLC_KNOWLEDGE_TOKEN=
ADLC_KNOWLEDGE_DIR=data/knowledge
ADLC_KNOWLEDGE_PORT=8020
# Host headers the knowledge server answers (DNS-rebinding protection).
ADLC_KNOWLEDGE_ALLOWED_HOSTS=knowledge:*,127.0.0.1:*,localhost:*

# MCP tool servers (feature 010). `tools` holds the eval store and enterprise mocks (platform
# network, database); `pilot-bridge` is the only service on both networks and holds no database
# or model settings. The token key signs per-call run tokens (at least 32 characters); generate it
# locally and never commit a real value.
ADLC_TOOLS_URL=http://tools:8030
ADLC_PILOT_BRIDGE_URL=http://pilot-bridge:8040
ADLC_TOOLS_TOKEN_KEY=
ADLC_TOOLS_TIMEOUT_S=120
ADLC_TOOLS_PORT=8030
ADLC_TOOLS_ALLOWED_HOSTS=tools:*,127.0.0.1:*,localhost:*
ADLC_CONTROLS_FILE=data/controls/controls.yaml
ADLC_BRIDGE_PORT=8040
ADLC_BRIDGE_ALLOWED_HOSTS=pilot-bridge:*,127.0.0.1:*,localhost:*
ADLC_BRIDGE_DATA_DIR=/var/lib/adlc/bridge
ADLC_BRIDGE_PILOT_DEV_URL=http://pilot-dev:8100
ADLC_BRIDGE_PILOT_TEST_URL=http://pilot-test:8100
ADLC_BRIDGE_PILOT_PRODSIM_URL=http://pilot-prodsim:8100
ADLC_BRIDGE_PILOT_LAB_URL=http://pilot-lab:8300
ADLC_BRIDGE_PILOT_TRAFFIC_URL=http://pilot-traffic:8200
ADLC_BRIDGE_JAEGER_URL=http://jaeger:16686
ADLC_BRIDGE_PILOT_SERVICE=pilot-triage-prod-sim
ADLC_BRIDGE_MONITOR_INTERVAL_S=30
ADLC_REDTEAM_SUITE=data/redteam/suite.yaml

# Web application (feature 007). The UI reaches the platform only through this API URL.
ADLC_API_URL=http://api:8000
ADLC_UI_PORT=8501
# How often the dashboard views refresh themselves (feature 013)
ADLC_UI_DASHBOARD_REFRESH=10s

# Pilot (feature 009): the Incident Triage Assistant's own settings, separate from the platform's.
# The pilot uses a simulated model by default; a real OpenAI-compatible model can be switched on in
# dev and test only. Never put a platform key here.
PILOT_MODEL_URL=https://api.openai.com/v1
PILOT_MODEL_NAME=gpt-4o-mini
PILOT_MODEL_API_KEY=
# Cost reported for real-model answers (the simulated model costs nothing); 0 when unknown.
PILOT_MODEL_PRICE_PER_1K_TOKENS=0
PILOT_TRAFFIC_RATE=1
PILOT_TRAFFIC_SEED=2026
PILOT_TRAFFIC_PII_SHARE=0.25
