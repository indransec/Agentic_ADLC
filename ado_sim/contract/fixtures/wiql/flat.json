{
  "operation": "wiql",
  "case": "flat",
  "description": "Epics changed since a time, with time precision",
  "reference": "https://learn.microsoft.com/en-us/rest/api/azure/devops/wit/wiql/query-by-wiql?view=azure-devops-rest-7.1",
  "identity": "adlc-platform@adlc.demo",
  "setup": [
    {
      "method": "POST",
      "path": "/adlc-demo/Agentic%20ADLC/_apis/wit/workitems/$Epic",
      "query": {
        "api-version": "7.1"
      },
      "headers": {
        "Content-Type": "application/json-patch+json"
      },
      "body": [
        {
          "op": "add",
          "path": "/fields/System.Title",
          "value": "Use case UC-1"
        },
        {
          "op": "add",
          "path": "/fields/System.AreaPath",
          "value": "Agentic ADLC\\Use cases"
        },
        {
          "op": "add",
          "path": "/fields/Custom.AdlcUseCaseId",
          "value": "UC-1"
        }
      ]
    },
    {
      "method": "POST",
      "path": "/adlc-demo/Agentic%20ADLC/_apis/wit/workitems/$Task",
      "query": {
        "api-version": "7.1"
      },
      "headers": {
        "Content-Type": "application/json-patch+json"
      },
      "body": [
        {
          "op": "add",
          "path": "/fields/System.Title",
          "value": "Task under UC-1"
        },
        {
          "op": "add",
          "path": "/relations/-",
          "value": {
            "rel": "System.LinkTypes.Hierarchy-Reverse",
            "url": "http://localhost:8600/adlc-demo/_apis/wit/workItems/1"
          }
        }
      ]
    }
  ],
  "request": {
    "method": "POST",
    "path": "/adlc-demo/Agentic%20ADLC/_apis/wit/wiql",
    "query": {
      "api-version": "7.1",
      "timePrecision": "true"
    },
    "headers": {
      "Content-Type": "application/json"
    },
    "body": {
      "query": "SELECT [System.Id], [System.Title] FROM workitems WHERE [System.WorkItemType] = 'Epic' AND [System.ChangedDate] >= '2000-01-01T00:00:00Z' ORDER BY [System.ChangedDate] ASC"
    }
  },
  "expected": {
    "status": 200,
    "body": {
      "queryType": "flat",
      "queryResultType": "workItem",
      "asOf": "<datetime>",
      "columns": [
        {
          "referenceName": "System.Id",
          "name": "ID",
          "url": "<url>"
        },
        {
          "referenceName": "System.Title",
          "name": "Title",
          "url": "<url>"
        }
      ],
      "sortColumns": [
        {
          "field": {
            "referenceName": "System.ChangedDate",
            "name": "Changed Date",
            "url": "<url>"
          },
          "descending": false
        }
      ],
      "workItems": [
        {
          "id": "<int>",
          "url": "<url>"
        }
      ]
    }
  }
}
