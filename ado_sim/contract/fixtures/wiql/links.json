{
  "operation": "wiql",
  "case": "links",
  "description": "Children of Epics (one hop)",
  "reference": "https://learn.microsoft.com/en-us/rest/api/azure/devops/wit/wiql/query-by-wiql?view=azure-devops-rest-7.1",
  "identity": "adlc-platform@adlc.demo",
  "setup": [
    {
      "method": "POST",
      "path": "/adlc-demo/Agentic%20ADLC/_apis/wit/workitems/$Epic",
      "query": {
        "api-version": "7.1"
      },
      "headers": {
        "Content-Type": "application/json-patch+json"
      },
      "body": [
        {
          "op": "add",
          "path": "/fields/System.Title",
          "value": "Use case UC-1"
        },
        {
          "op": "add",
          "path": "/fields/System.AreaPath",
          "value": "Agentic ADLC\\Use cases"
        },
        {
          "op": "add",
          "path": "/fields/Custom.AdlcUseCaseId",
          "value": "UC-1"
        }
      ]
    },
    {
      "method": "POST",
      "path": "/adlc-demo/Agentic%20ADLC/_apis/wit/workitems/$Task",
      "query": {
        "api-version": "7.1"
      },
      "headers": {
        "Content-Type": "application/json-patch+json"
      },
      "body": [
        {
          "op": "add",
          "path": "/fields/System.Title",
          "value": "Task under UC-1"
        },
        {
          "op": "add",
          "path": "/relations/-",
          "value": {
            "rel": "System.LinkTypes.Hierarchy-Reverse",
            "url": "http://localhost:8600/adlc-demo/_apis/wit/workItems/1"
          }
        }
      ]
    }
  ],
  "request": {
    "method": "POST",
    "path": "/adlc-demo/Agentic%20ADLC/_apis/wit/wiql",
    "query": {
      "api-version": "7.1"
    },
    "headers": {
      "Content-Type": "application/json"
    },
    "body": {
      "query": "SELECT [System.Id] FROM workitemLinks WHERE [Source].[System.WorkItemType] = 'Epic' AND [System.Links.LinkType] = 'System.LinkTypes.Hierarchy-Forward' MODE (MustContain)"
    }
  },
  "expected": {
    "status": 200,
    "body": {
      "queryType": "oneHop",
      "queryResultType": "workItemLink",
      "asOf": "<datetime>",
      "columns": [
        {
          "referenceName": "System.Id",
          "name": "ID",
          "url": "<url>"
        }
      ],
      "sortColumns": [],
      "workItemRelations": [
        {
          "rel": null,
          "source": null,
          "target": {
            "id": "<int>",
            "url": "<url>"
          }
        },
        {
          "rel": "System.LinkTypes.Hierarchy-Forward",
          "source": {
            "id": "<int>",
            "url": "<url>"
          },
          "target": {
            "id": "<int>",
            "url": "<url>"
          }
        }
      ]
    }
  }
}
