# Running without Docker (docs/run-without-docker.md): the values that differ from compose.
# Loaded AFTER .env, so these win; secrets and the account file still come from .env.
# Every process runs on this host: services are addressed as 127.0.0.1, each on its own port,
# and data lives under data/local/ (git-ignored).

# Data store and evidence files
ADLC_DB_PATH=data/local/adlc.db
ADLC_FILE_STORE_DIR=data/local/files

# Traces: Phoenix (make phoenix, or the `phoenix` process of deploy/Procfile.local)
ADLC_OTLP_ENDPOINT=http://127.0.0.1:6006
ADLC_BRIDGE_PHOENIX_URL=http://127.0.0.1:6006

# Platform services the orchestrator calls
ADLC_KNOWLEDGE_URL=http://127.0.0.1:8020
ADLC_TOOLS_URL=http://127.0.0.1:8030
ADLC_PILOT_BRIDGE_URL=http://127.0.0.1:8040

# The pilot bridge and the pilot: one port per environment host (compose gives each its own
# address on 8100)
ADLC_BRIDGE_DATA_DIR=data/local/bridge
ADLC_BRIDGE_PILOT_DEV_URL=http://127.0.0.1:8101
ADLC_BRIDGE_PILOT_TEST_URL=http://127.0.0.1:8102
ADLC_BRIDGE_PILOT_PRODSIM_URL=http://127.0.0.1:8103
ADLC_BRIDGE_PILOT_TRAFFIC_URL=http://127.0.0.1:8200
ADLC_BRIDGE_PILOT_LAB_URL=http://127.0.0.1:8300

# ADO simulator (feature 015): its token key comes from .env; its data file is set in
# deploy/Procfile.local (relative to ado_sim/), under data/local/ado_sim/
ADO_SIM_PORT=8600
ADO_SIM_SEED_FILE=seed/demo.yaml
ADO_SIM_OTLP_ENDPOINT=http://127.0.0.1:6006

# Board engagement (feature 016): the simulator's local port
ADLC_BOARD_URL=http://127.0.0.1:8600
ADLC_BOARD_EVIDENCE_URL=http://127.0.0.1:8501/?run=
