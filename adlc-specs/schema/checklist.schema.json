{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adlc.local/schema/checklist.schema.json",
  "title": "ADLC reviewer checklist",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "checklist": {
      "type": "string",
      "pattern": "^t[0-9]+$"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^CHK-T[0-9]+-[0-9]{2}$"
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "text"
        ]
      },
      "minItems": 1
    }
  },
  "required": [
    "checklist",
    "version",
    "items"
  ]
}
