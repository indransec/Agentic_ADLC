{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adlc.local/schema/catalogues/metrics.schema.json",
  "title": "ADLC catalogue: metrics",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "catalogue": {
      "const": "metrics"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "metrics": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$"
          },
          "class": {
            "enum": [
              "quality",
              "rai",
              "cost",
              "latency",
              "reliability",
              "business_kpi",
              "safety",
              "engineering"
            ]
          },
          "unit": {
            "enum": [
              "ratio",
              "pct",
              "ms",
              "usd",
              "count",
              "score",
              "bool"
            ]
          },
          "direction": {
            "enum": [
              "higher_is_better",
              "lower_is_better"
            ]
          },
          "method": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "name",
          "class",
          "unit",
          "direction",
          "method",
          "description"
        ]
      }
    }
  },
  "required": [
    "catalogue",
    "version",
    "metrics"
  ]
}
