{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adlc.local/schema/catalogues/mcp_servers.schema.json",
  "title": "ADLC catalogue: mcp_servers",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "catalogue": {
      "const": "mcp_servers"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "bound_values": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "candidate_hash": {"type": "string", "pattern": "^[A-Z][0-9]+\\.[a-z][a-z0-9_]*$"},
        "authorised_hash": {"type": "string", "pattern": "^[A-Z][0-9]+\\.[a-z][a-z0-9_]*$"}
      },
      "required": ["candidate_hash", "authorised_hash"]
    },
    "mcp_servers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$"
          },
          "host": {
            "enum": ["knowledge", "tools", "bridge"]
          },
          "owner_role": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$"
          },
          "scopes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$"
            }
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "host",
          "owner_role",
          "scopes",
          "description"
        ]
      }
    }
  },
  "required": [
    "catalogue",
    "version",
    "mcp_servers"
  ]
}
