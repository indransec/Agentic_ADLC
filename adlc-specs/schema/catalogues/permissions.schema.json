{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adlc.local/schema/catalogues/permissions.schema.json",
  "title": "ADLC catalogue: permissions",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "catalogue": {
      "const": "permissions"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "verbs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z]+$"
      }
    },
    "duty_groups": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "string",
          "pattern": "^[a-z]+:[A-Za-z0-9_.*-]+$"
        }
      }
    }
  },
  "required": [
    "catalogue",
    "version",
    "verbs",
    "duty_groups"
  ]
}
