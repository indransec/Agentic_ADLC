{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adlc.local/schema/catalogues/model_catalogue.schema.json",
  "title": "ADLC catalogue: model_catalogue",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "catalogue": {
      "const": "model_catalogue"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "profiles": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$"
      },
      "additionalProperties": {
        "type": "object",
        "minProperties": 1,
        "propertyNames": {
          "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$"
        },
        "additionalProperties": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "provider": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$"
              },
              "model": {
                "type": "string",
                "pattern": "^[a-z0-9_-]+/[A-Za-z0-9._:-]+$"
              },
              "input_per_mtok": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "output_per_mtok": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "max_output_tokens": {
                "type": "integer",
                "minimum": 1
              },
              "context_tokens": {
                "type": "integer",
                "minimum": 1
              },
              "max_data_class": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$"
              },
              "params": {
                "type": "object"
              }
            },
            "required": [
              "provider",
              "model",
              "input_per_mtok",
              "output_per_mtok",
              "max_output_tokens",
              "context_tokens",
              "max_data_class"
            ]
          }
        }
      }
    }
  },
  "required": [
    "catalogue",
    "version",
    "profiles"
  ]
}
