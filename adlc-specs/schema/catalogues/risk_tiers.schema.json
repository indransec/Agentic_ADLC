{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adlc.local/schema/catalogues/risk_tiers.schema.json",
  "title": "ADLC catalogue: risk_tiers",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "catalogue": {
      "const": "risk_tiers"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "risk_tiers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "rank": {
            "type": "integer",
            "minimum": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "rank",
          "description"
        ]
      }
    }
  },
  "required": [
    "catalogue",
    "version",
    "risk_tiers"
  ]
}
