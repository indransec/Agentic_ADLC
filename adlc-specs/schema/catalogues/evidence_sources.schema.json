{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adlc.local/schema/catalogues/evidence_sources.schema.json",
  "title": "ADLC catalogue: evidence_sources",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "catalogue": {
      "const": "evidence_sources"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "evidence_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$"
          },
          "fields": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$"
            }
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "from_pilot": {
            "description": "012: how the pilot's observability metrics give this source's fields: a metric, or a ratio of two with an optional scale",
            "type": "object",
            "additionalProperties": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "metric": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]*$"
                    }
                  },
                  "required": [
                    "metric"
                  ]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "ratio": {
                      "type": "array",
                      "items": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9_]*$"
                      },
                      "minItems": 2,
                      "maxItems": 2
                    },
                    "scale": {
                      "type": "number",
                      "exclusiveMinimum": 0
                    }
                  },
                  "required": [
                    "ratio"
                  ]
                }
              ]
            }
          }
        },
        "required": [
          "id",
          "fields",
          "description"
        ]
      }
    }
  },
  "required": [
    "catalogue",
    "version",
    "evidence_sources"
  ]
}
