{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adlc.local/schema/catalogues/agents.schema.json",
  "title": "ADLC catalogue: agents",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "catalogue": {
      "const": "agents"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "agents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
          },
          "version": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "implementation": {
            "enum": [
              "stub",
              "model"
            ]
          },
          "model_tier": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$"
          },
          "prompt": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*$"
              },
              "version": {
                "type": "string",
                "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
              }
            },
            "required": [
              "id",
              "version"
            ]
          },
          "tools": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "tool": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9]*(_[a-z0-9]+)*$"
                },
                "permission": {
                  "type": "string",
                  "pattern": "^[a-z_]+:[A-Za-z0-9_.*:/-]+$"
                }
              },
              "required": [
                "tool",
                "permission"
              ]
            }
          }
        },
        "required": [
          "id",
          "version",
          "implementation",
          "model_tier",
          "tools"
        ],
        "if": {
          "properties": {
            "implementation": {
              "const": "model"
            }
          }
        },
        "then": {
          "required": [
            "prompt"
          ]
        }
      }
    }
  },
  "required": [
    "catalogue",
    "version",
    "agents"
  ]
}
