            <root>
                <mxCell id="0"/>
                <mxCell id="1" parent="0"/>
                <mxCell id="a3-t-1" value="&lt;b&gt;Event-driven processing on Azure: outbox, Service Bus and KEDA-scaled workers&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=22;fontColor=#14213D;fontFamily=Inter;" vertex="1" parent="1">
                    <mxGeometry x="20" y="10" width="1500" height="32" as="geometry"/>
                </mxCell>
                <mxCell id="a3-t-2" value="PostgreSQL stays the single source of truth for run state; Service Bus carries work; dashed = optional" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#4A5568;fontFamily=Inter;" vertex="1" parent="1">
                    <mxGeometry x="20" y="42" width="1500" height="22" as="geometry"/>
                </mxCell>
