<mxCell id="b-evidence" value="&lt;b&gt;&lt;font style=&quot;font-size:14px&quot;&gt;evidence&lt;/font&gt;&lt;/b&gt;&lt;br&gt;ARTIFACT_DEF 1..* · format, required, bound_to&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ARTIFACT_COLUMN 1..* · name, order&lt;br&gt;LEDGER_POLICY 1 · key, immutable, retention" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fontSize=12;fillColor=#FFFFFF;strokeColor=#64748B;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="604" y="330" width="500" height="100" as="geometry"/></mxCell>
