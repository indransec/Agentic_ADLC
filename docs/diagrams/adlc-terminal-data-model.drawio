<mxCell id="b-extensions" value="&lt;b&gt;&lt;font style=&quot;font-size:14px&quot;&gt;extensions&lt;/font&gt;&lt;/b&gt;&lt;br&gt;MONITOR 0..* · signal, threshold, raises (T8)&lt;br&gt;CHANGE_CLASS 0..* · reentry, path (T9)&lt;br&gt;RETIREMENT_STEP 0..* · sequence (T9)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fontSize=12;fillColor=#FFFFFF;strokeColor=#64748B;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="604" y="720" width="500" height="100" as="geometry"/></mxCell>
