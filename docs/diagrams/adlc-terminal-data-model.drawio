<diagram id="spec" name="C.1 Spec model"><mxGraphModel dx="1200" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="980" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="spec-title" value="&lt;b&gt;Terminal spec model: one spec version owns ten child collections&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="36" y="20" width="1080" height="32" as="geometry"/></mxCell>
<mxCell id="spec-sub" value="Each box is one YAML block · entity names in capitals with cardinality and key fields · → references a shared catalogue" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#64748B;" vertex="1" parent="1"><mxGeometry x="36" y="54" width="1080" height="24" as="geometry"/></mxCell>
<mxCell id="spec" value="&lt;b&gt;&lt;font style=&quot;font-size:14px&quot;&gt;TERMINAL_SPEC&lt;/font&gt;&lt;/b&gt;&lt;br&gt;PK terminal_id + version · metadata" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=center;verticalAlign=top;spacingLeft=0;spacingTop=6;fontSize=12;fillColor=#E8F1FC;strokeColor=#2563EB;strokeWidth=2;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="400" y="96" width="340" height="64" as="geometry"/></mxCell>
<mxCell id="b-trigger" value="&lt;b&gt;&lt;font style=&quot;font-size:14px&quot;&gt;trigger&lt;/font&gt;&lt;/b&gt;&lt;br&gt;TRIGGER_EVENT 1..* · event_type → EVENT_TYPE&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;mode · event | scheduled | continuous&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fontSize=12;fillColor=#FFFFFF;strokeColor=#64748B;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="36" y="200" width="500" height="80" as="geometry"/></mxCell>
<mxCell id="e-trigger" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;startArrow=none;strokeColor=#64748B;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="spec" target="b-trigger"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="b-prerequisites" value="&lt;b&gt;&lt;font style=&quot;font-size:14px&quot;&gt;prerequisites&lt;/font&gt;&lt;/b&gt;&lt;br&gt;PREREQUISITE 1..* · evidence_ref, condition&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;on_missing · block | warn&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fontSize=12;fillColor=#FFFFFF;strokeColor=#64748B;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="36" y="310" width="500" height="80" as="geometry"/></mxCell>
<mxCell id="e-prerequisites" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;startArrow=none;strokeColor=#64748B;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="spec" target="b-prerequisites"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="b-actors" value="&lt;b&gt;&lt;font style=&quot;font-size:14px&quot;&gt;actors&lt;/font&gt;&lt;/b&gt;&lt;br&gt;ACTOR 1..* · agent | subagent | reviewer&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;model_tier → MODEL_TIER, responsibility&lt;/font&gt;&lt;br&gt;ROLE_ASSIGNMENT 1..* · raci, scope → ROLE" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fontSize=12;fillColor=#FFFFFF;strokeColor=#64748B;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="36" y="420" width="500" height="100" as="geometry"/></mxCell>
<mxCell id="e-actors" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;startArrow=none;strokeColor=#64748B;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="spec" target="b-actors"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="b-authorities" value="&lt;b&gt;&lt;font style=&quot;font-size:14px&quot;&gt;authorities&lt;/font&gt;&lt;/b&gt;&lt;br&gt;PERMISSION 1..* · allow | deny | emergency&lt;br&gt;TOOL_SCOPE 0..* · scope → MCP_SERVER&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;data_access.max_class → DATA_CLASS&lt;/font&gt;&lt;br&gt;SIGN_OFF_RULE 1..* · roles, min_approvers, tier&lt;br&gt;STATUS_RIGHT 1..* · actor_class → statuses" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fontSize=12;fillColor=#FFFFFF;strokeColor=#64748B;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="36" y="550" width="500" height="140" as="geometry"/></mxCell>
<mxCell id="e-authorities" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=none;startArrow=none;strokeColor=#64748B;strokeWidth=1.5;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="spec" target="b-authorities"><mxGeometry relative="1" as="geometry"/></mxCell>
<mxCell id="b-playbooks" value="&lt;b&gt;&lt;font style=&quot;font-size:14px&quot;&gt;playbooks&lt;/font&gt;&lt;/b&gt;&lt;br&gt;PLAYBOOK 1..* · ref, version, applies_when&lt;br&gt;GROUNDING_SOURCE 0..* · scope → MCP_SERVER" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fontSize=12;fillColor=#FFFFFF;strokeColor=#64748B;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="36" y="740" width="500" height="80" as="geometry"/></mxCell>
