<mxCell id="b-controls" value="&lt;b&gt;&lt;font style=&quot;font-size:14px&quot;&gt;controls&lt;/font&gt;&lt;/b&gt;&lt;br&gt;CONTROL 1..* · rule, severity, applies&lt;br&gt;CHECKLIST_ITEM 1..* · item_id, text&lt;br&gt;TIER_PROFILE 0..3 · overrides → RISK_TIER" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fontSize=12;fillColor=#FFFFFF;strokeColor=#64748B;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="604" y="200" width="500" height="100" as="geometry"/></mxCell>
