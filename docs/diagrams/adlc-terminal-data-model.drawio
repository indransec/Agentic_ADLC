<mxCell id="b-timeline" value="&lt;b&gt;&lt;font style=&quot;font-size:14px&quot;&gt;timeline&lt;/font&gt;&lt;/b&gt;&lt;br&gt;TIMELINE_POLICY 1..3 · one per RISK_TIER&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;duration, reminder, escalate, max_rework&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fontSize=12;fillColor=#FFFFFF;strokeColor=#64748B;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="604" y="590" width="500" height="80" as="geometry"/></mxCell>
