<mxCell id="b-outcome_model" value="&lt;b&gt;&lt;font style=&quot;font-size:14px&quot;&gt;outcome_model&lt;/font&gt;&lt;/b&gt;&lt;br&gt;OUTCOME_ROUTE 5..* · status, root_cause, route&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;requires, set_by, emits, recheck_at&lt;/font&gt;&lt;br&gt;EVENT_ROUTE 0..* · event → action (T8)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fontSize=12;fillColor=#FFFFFF;strokeColor=#64748B;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="604" y="460" width="500" height="100" as="geometry"/></mxCell>
