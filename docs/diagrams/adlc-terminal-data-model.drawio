<diagram id="runtime" name="C.2 Runtime model"><mxGraphModel dx="1200" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="980" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/>
<mxCell id="runtime-title" value="&lt;b&gt;Terminal runtime model: every run links a use case, its pinned spec and its evidence&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=20;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="36" y="20" width="1080" height="32" as="geometry"/></mxCell>
<mxCell id="runtime-sub" value="Crow's-foot notation · LEDGER_RECORD and OUTBOX_EVENT are written in one database transaction" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontColor=#64748B;" vertex="1" parent="1"><mxGeometry x="36" y="54" width="1080" height="24" as="geometry"/></mxCell>
<mxCell id="specreg" value="&lt;b&gt;&lt;font style=&quot;font-size:14px&quot;&gt;SPEC_REGISTRY&lt;/font&gt;&lt;/b&gt;&lt;br&gt;PK terminal_id, version&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;status, spec_yaml, spec_json, content_hash&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;trigger_events, emitted_events&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fontSize=12;fillColor=#FFFFFF;strokeColor=#64748B;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="36" y="120" width="320" height="110" as="geometry"/></mxCell>
<mxCell id="pin" value="&lt;b&gt;&lt;font style=&quot;font-size:14px&quot;&gt;USECASE_SPEC_PIN&lt;/font&gt;&lt;/b&gt;&lt;br&gt;PK usecase_id, terminal_id&lt;br&gt;FK terminal_id, version → SPEC_REGISTRY&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;pinned_at, pinned_reason&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fontSize=12;fillColor=#FFFFFF;strokeColor=#64748B;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="36" y="310" width="320" height="110" as="geometry"/></mxCell>
<mxCell id="usecase" value="&lt;b&gt;&lt;font style=&quot;font-size:14px&quot;&gt;USECASE&lt;/font&gt;&lt;/b&gt;&lt;br&gt;PK usecase_id&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;name, business_owner, risk_tier&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;status, created_at&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fontSize=12;fillColor=#FFFFFF;strokeColor=#64748B;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="36" y="500" width="320" height="110" as="geometry"/></mxCell>
<mxCell id="run" value="&lt;b&gt;&lt;font style=&quot;font-size:14px&quot;&gt;TERMINAL_RUN&lt;/font&gt;&lt;/b&gt;&lt;br&gt;PK run_id (usecase_id/terminal_id/run_version)&lt;br&gt;FK usecase_id → USECASE&lt;br&gt;FK terminal_id, spec_version → SPEC_REGISTRY&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;trigger_event_id, status, recommended_status&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;rework_count, opened_at, due_at, closed_at&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fontSize=12;fillColor=#E8F1FC;strokeColor=#2563EB;strokeWidth=2;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="420" y="330" width="340" height="150" as="geometry"/></mxCell>
<mxCell id="outbox" value="&lt;b&gt;&lt;font style=&quot;font-size:14px&quot;&gt;OUTBOX_EVENT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;PK event_id&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;event_type, usecase_id, payload&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;causation_run_id, attempts, processed_at&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;opens the next TERMINAL_RUN&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fontSize=12;fillColor=#FFFFFF;strokeColor=#64748B;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="420" y="610" width="340" height="130" as="geometry"/></mxCell>
<mxCell id="prq" value="&lt;b&gt;&lt;font style=&quot;font-size:14px&quot;&gt;PREREQUISITE_RESULT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;PK run_id, prereq_id&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;evidence_ref, result, checked_at&lt;/font&gt;" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fontSize=12;fillColor=#FFFFFF;strokeColor=#64748B;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="830" y="110" width="300" height="84" as="geometry"/></mxCell>
