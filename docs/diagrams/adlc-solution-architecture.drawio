<mxCell id="rmp-title" value="&lt;b&gt;Each phase adds capability behind interfaces the MVP already defines&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontColor=#0F172A;" vertex="1" parent="1"><mxGeometry x="36" y="18" width="1068" height="36" as="geometry"/></mxCell>
<mxCell id="rmp-sub" value="Roadmap · phases not to scale; only the MVP date is fixed" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#64748B;" vertex="1" parent="1"><mxGeometry x="36" y="57" width="1068" height="27" as="geometry"/></mxCell>
<mxCell id="rmp-p1" value="&lt;b&gt;&lt;font style=&quot;font-size:13px&quot;&gt;Phase 1 · MVP&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;by mid-Dec 2026&lt;/font&gt;&lt;br&gt;&lt;br&gt;1 use case, T0 to T9&lt;br&gt;YAML + CEL specs&lt;br&gt;Postgres ledger, outbox&lt;br&gt;Simulated T7 and T8&lt;br&gt;Inbox + dashboard" style="whiteSpace=wrap;html=1;fontColor=#0F172A;rounded=1;arcSize=8;fillColor=#E8F1FC;strokeColor=#2563EB;strokeWidth=2;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;" vertex="1" parent="1"><mxGeometry x="36" y="108" width="258" height="240" as="geometry"/></mxCell>
<mxCell id="rmp-p2" value="&lt;b&gt;&lt;font style=&quot;font-size:13px&quot;&gt;Phase 2 · Harden&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;next iteration&lt;/font&gt;&lt;br&gt;&lt;br&gt;3 to 5 use cases&lt;br&gt;permission_tool_map&lt;br&gt;Real knowledge, ITSM&lt;br&gt;Spec bundles&lt;br&gt;Teams approvals" style="whiteSpace=wrap;html=1;fontColor=#0F172A;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#64748B;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="306" y="108" width="258" height="240" as="geometry"/></mxCell>
<mxCell id="rmp-p3" value="&lt;b&gt;&lt;font style=&quot;font-size:13px&quot;&gt;Phase 3 · Scale&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#64748B&quot;&gt;later&lt;/font&gt;&lt;br&gt;&lt;br&gt;Multi-agent use cases&lt;br&gt;Subagent permissions&lt;br&gt;Portfolio dashboard&lt;br&gt;Signed specs&lt;br&gt;Kafka + Kubernetes" style="whiteSpace=wrap;html=1;fontColor=#0F172A;rounded=1;arcSize=8;fillColor=#FFFFFF;strokeColor=#64748B;fontSize=12;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="576" y="108" width="258" height="240" as="geometry"/></mxCell>
