# Copy to .env (git-ignored) and replace every REPLACE_ME. See
# specs/001-platform-foundation/contracts/settings.md for every setting.
# Values here are the host-side ones; deploy/compose.yaml overrides DB host/port and the
# account file path inside containers ("Host and container values").

ADLC_ENV=dev

# Data store
ADLC_DB_HOST=localhost
ADLC_DB_PORT=5432
ADLC_DB_NAME=adlc
ADLC_DB_APP_USER=adlc_app
ADLC_DB_APP_PASSWORD=_Q2ZL-puqRLWSaE3m4kkPEswcRjYvd00unma05yPTdY
ADLC_DB_OWNER_USER=adlc_owner
ADLC_DB_OWNER_PASSWORD=9Rs3snPkuS9nrpT81hUIIb-a42yC0lMLZnEPTd1ClpY
ADLC_DB_CONNECT_TIMEOUT=60s
# Container superuser: used only by the init script, never by a platform service.
POSTGRES_PASSWORD=f7FZwuIs4t6mXzKgw23llwCvPy-g8LuYlrlxiBi7vKM

# Sessions and accounts
ADLC_SESSION_SECRET=XXcwivaR5_6o1yFDdfchbVrowekD71VodRVyXiUGIAE
ADLC_SESSION_TTL=8h
# Absolute path to the account file outside the repo, e.g. $HOME/.config/adlc/accounts.dev.yaml
#ADLC_ACCOUNTS_FILE=/private/tmp/claude-501/-Users-indra-developments-Agentic-ADLC/dc95f319-f125-480f-b93f-4efc5115543b/scratchpad/accounts.dev.yaml
ADLC_ACCOUNTS_FILE=/Users/indra/.config/adlc/accounts.dev.yaml
ADLC_ROLE_CATALOGUE=adlc-specs/shared/roles.yaml

# Tracing and logging
ADLC_OTLP_ENDPOINT=http://jaeger:4318
ADLC_LOG_LEVEL=INFO

# Host ports published by deploy/compose.yaml
ADLC_API_PORT=8010
ADLC_JAEGER_UI_PORT=16686

# Orchestrator (feature 003)
ADLC_TIME_SCALE=1.0
ADLC_POLL_INTERVAL=1s
ADLC_LEASE=5min
ADLC_HEARTBEAT_MAX_AGE=30s
ADLC_DEADLETTER_ROLE=adlc_coe
ADLC_MODEL_PROFILE=dev

ADLC_REVIEWER_MODE=model
# Knowledge MCP server token (feature 008), generated locally; never commit it.
ADLC_KNOWLEDGE_TOKEN=4f60371ac0393aaa2dc991382f29f79ae5df00d30df9953c

# Feature 010 run-token key (generated locally, never commit)
ADLC_TOOLS_TOKEN_KEY=8fba6c062f2946e127358d6312ccfd434f2047773478d475
